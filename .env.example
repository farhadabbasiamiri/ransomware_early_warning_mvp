# Copy to .env (never commit real keys). All settings are optional.
REWA_LLM_PROVIDER=ollama            # ollama | openai | offline
REWA_LLM_BASE_URL=http://localhost:11434
REWA_LLM_MODEL=qwen2.5:7b-instruct  # also tested design-wise for llama3.1:8b, mistral-nemo
REWA_LLM_API_KEY=                   # only for OpenAI-compatible servers
REWA_LLM_TIMEOUT_S=90
REWA_EMBEDDING_BACKEND=tfidf        # tfidf | sbert
REWA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
REWA_ALERT_THRESHOLD=45
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
